# KeySpex Backend Environment Configuration Template
# Copy this file to .env and configure appropriate values

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=keyspex
FIREBASE_STORAGE_BUCKET=keyspex.firebasestorage.app

# Security salt for IP hashing (min 16 characters)
IP_HASH_SALT=keyspex_secure_random_salt_sample_12345

# Rate Limiting
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=15

# Mailer Configuration (Optional)
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
MAIL_FROM=noreply@example.com
MAIL_NOTIFY_TO=admin@example.com
