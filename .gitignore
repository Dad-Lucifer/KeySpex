# ============================================================
# Root .gitignore for KeySpex Community Workspace
# Covers both /backend and /keyspex (frontend)
# ============================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
bin/
*/bin/

# Environment variables & secrets (CRITICAL: Never commit to git)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example
serviceAccountKey.json
*/serviceAccountKey.json
credentials.json
*/credentials.json
*.pem
*.key
*.cert

# Logs
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
firebase-debug.log*
firestore-debug.log*

# Testing & coverage
coverage/
*/coverage/
.nyc_output/
*/.nyc_output/
*.lcov

# Editor directories and system files
.vscode/*
!.vscode/extensions.json
.idea/
*/.idea/
.DS_Store
*/.DS_Store
Thumbs.db
*/Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cache directories
.eslintcache
*/.eslintcache
.vite/
*/.vite/
.turbo/
*/.turbo/
.cache/
*/.cache/
